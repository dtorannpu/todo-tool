{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": [
    "before 6am on monday"
  ],
  "assignees": [
    "dtorannpu"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "react"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"],
      "groupName": "vitest"
    }
  ]
}
